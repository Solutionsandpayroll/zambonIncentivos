# ============================================================================
#  Backend NestJS — variables de entorno
#  Copia como .env dentro de backend/ (o exporta desde el .env raíz).
#  DATABASE_URL / DIRECT_URL se heredan del .env de la raíz del proyecto.
# ============================================================================

# Base de datos (mismas cadenas que el .env raíz — Supabase/PostgreSQL)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Servidor
PORT=3000
NODE_ENV=development

# Seguridad — JWT de sesión + refresh token
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=otro-secreto-distinto-y-largo
REFRESH_TOKEN_EXPIRES_IN=7d

# Reglas de negocio (bolsas teóricas del salario base)
INCENTIVE_80_RATE=0.80
INCENTIVE_20_RATE=0.20
