# ============================================================================
#  Plantilla de variables de entorno — Sistema de Incentivos Zambon
#
#  Copia este archivo como  .env  y reemplaza los valores por los reales.
#  El .env NUNCA se sube a git (está en .gitignore). Este .env.example sí.
# ============================================================================

# --- Base de datos (Supabase / PostgreSQL) --------------------------------
# Obtén ambas cadenas en Supabase: Connect -> Prisma (o Project Settings -> Database).
# Reemplaza [PROJECT-REF], [PASSWORD] y [REGION] por tus valores reales.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.yuswnhucfivuevqiyklf:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.yuswnhucfivuevqiyklf:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Backend (NestJS) ------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- CORS ------------------------------------------------------------------
# Déjala VACÍA mientras el backend sirva también el frontend (mismo origen):
# en ese caso CORS no hace falta y se queda desactivado.
#
# Solo si el frontend pasa a otro dominio, lista aquí los orígenes exactos
# separados por coma. No se admite '*' (el arranque se aborta).
#   CORS_ORIGINS=https://incentivos.zambon.com,https://admin.zambon.com
CORS_ORIGINS=

# --- Secretos de firma JWT -------------------------------------------------
# OBLIGATORIOS con NODE_ENV=production: si faltan, el arranque se aborta.
# En desarrollo son opcionales (se usa un valor fijo de dev).
#
# Genera cada uno por separado — deben ser DISTINTOS entre sí:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
#
# Nunca reutilices los secretos de desarrollo en producción, y en el servidor
# cárgalos con el gestor de variables del hosting, no con un archivo .env.
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# --- Usuario administrador inicial (solo para `npm run seed:roles`) --------
# Si se omite, el seed genera una contraseña temporal y la imprime una vez.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
